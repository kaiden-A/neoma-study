# Copy to server/.env and fill in. Never commit the real file.

# --- database -------------------------------------------------------------
# Neon connection string, e.g.
# postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require
DATABASE_URL=
# Schema on every table (Neon's pooler makes search_path unreliable).
DB_SCHEMA=public

# --- app ------------------------------------------------------------------
# HMAC key for the short-lived OAuth handshake cookie.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=dev-only-insecure-secret
# Header secret for POST /api/maintenance/*; empty disables those routes.
CLEANUP_SECRET=
API_BASE_URL=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:3000

# --- Zitadel OIDC (PKCE public client, no secret) -------------------------
# Instance URL, no trailing slash.
ZITADEL_ISSUER=https://<instance>.zitadel.cloud
ZITADEL_CLIENT_ID=
# Both must be whitelisted exactly in the Zitadel application.
ZITADEL_REDIRECT_URI=http://localhost:3000/api/auth/callback
ZITADEL_POST_LOGOUT_URI=http://localhost:3000/login

# --- sessions -------------------------------------------------------------
# Production on Firebase Hosting must be __session (cookies are stripped).
SESSION_COOKIE_NAME=neoma_session
SESSION_TTL_DAYS=30
GUEST_TTL_DAYS=7
COOKIE_SECURE=false

# Only needed when client and API are different origins.
CORS_ORIGINS=

# --- MCP (Elpis) ----------------------------------------------------------
# The one timezone MCP tools use; IANA name (tzdata is a dependency).
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur
MCP_ENABLED=true
# The static bearer key; empty disables key auth (fail closed).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=
# The member the static key acts as.
MCP_OWNER_EMAIL=
# DNS-rebinding protection; must include every deployed hostname.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
# Browser Origin allowlist; empty rejects browser origins.
MCP_ALLOWED_ORIGINS=
# Required aud on Zitadel access tokens; empty skips the check.
MCP_AUDIENCE=
# Defaults to {issuer}/oauth/v2/keys.
MCP_JWKS_URL=

# --- object storage (Cloudflare R2, S3-compatible) ------------------------
# The R2 dashboard names these ACCESS_KEY_ID / SECRET_ACCESS_KEY / S3_API /
# BUCKET_NAMES; both spellings are accepted.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=neoma-study
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_TTL_SECONDS=600
# Hard cap for a single upload, bytes (15 MB, matches the client preflight).
MAX_UPLOAD_BYTES=15728640

# --- email (Resend) -------------------------------------------------------
# Empty key disables sending: emails are rendered and logged instead.
RESEND_API_KEY=
EMAIL_FROM=Neoma <onboarding@resend.dev>
EMAIL_REPLY_TO=
# When set, every email is redirected here (useful in dev).
EMAIL_OVERRIDE_TO=

# --- Google Calendar ------------------------------------------------------
# OAuth client from GCP; docs/google-calendar.md has the walkthrough.
# Both redirect URIs (dev + production) must be whitelisted in the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
