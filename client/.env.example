# Canonical origin used by metadata, sitemap.xml and robots.txt. Set this in
# production (for example https://neoma.example.com). On Vercel the production
# deployment URL is used when it is unset; local dev falls back to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Where the FastAPI server lives for the /api rewrite.
API_ORIGIN=http://localhost:8000
